# PropGraph MCP Environment Configuration
PROPGRAPH_HOST=127.0.0.1
PROPGRAPH_PORT=8000
PROPGRAPH_LOG_LEVEL=INFO

# SEC EDGAR API User-Agent (Required by SEC: Name email@domain.com)
SEC_EDGAR_USER_AGENT=PropGraphAdmin research@propgraph.io

# Municipal Deed Ingestion Feeds
DEED_STREAM_URL=
DEED_STREAM_API_KEY=

# Vector / Graph DB persistence path (optional SQLite / DuckDB fallback)
GRAPH_STORE_PATH=./data/graph.db
